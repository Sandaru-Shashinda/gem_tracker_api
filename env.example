# Database Configuration
MONGO_URI=mongodb://localhost:27017/gem-tracker

# Optional. Only needed if a mongodb+srv:// URI fails with `querySrv ECONNREFUSED`,
# which means Node's DNS resolver can't reach a working DNS server.
# Defaults to 1.1.1.1,8.8.8.8 when the lookup fails.
# DNS_SERVERS=1.1.1.1,8.8.8.8

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-in-production

# Server Configuration
PORT=5000
NODE_ENV=development

# Public URL (for reports and QR codes)
# For local development
PUBLIC_URL=http://localhost:5000

# For production, use your Vercel URL or custom domain
# PUBLIC_URL=https://your-vercel-app.vercel.app
