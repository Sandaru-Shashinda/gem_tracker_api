# Database Configuration
MONGO_URI=mongodb://localhost:27017/gem-tracker

# Optional. Only needed if a mongodb+srv:// URI fails with `querySrv ECONNREFUSED`,
# which means Node's DNS resolver can't reach a working DNS server.
# Defaults to 1.1.1.1,8.8.8.8 when the lookup fails.
# DNS_SERVERS=1.1.1.1,8.8.8.8

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-in-production

# Server Configuration
PORT=5000
NODE_ENV=development

# Public URL (for reports and QR codes)
# For local development
PUBLIC_URL=http://localhost:5000

# For production, use your Vercel URL or custom domain
# PUBLIC_URL=https://your-vercel-app.vercel.app

# Google Drive (each gem's photos and videos). Leave unset to turn the feature off.
# A service account that is a Content Manager of the lab's Shared Drive.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=gem-tracker@your-project.iam.gserviceaccount.com
# The "private_key" from the service account's JSON key, on one line with \n kept as is.
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The Shared Drive's id (from its URL), or a folder inside it. Gem folders are made here.
# GOOGLE_DRIVE_ROOT_FOLDER_ID=0AbCdEfGhIjKlMnOp
